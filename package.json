{
  "name": "aem-suite",
  "version": "1.0.0",
  "description": "Test suite for SAP Advanced Event Mesh brokers: test cases, multi-broker runs and live subscriptions.",
  "license": "UNLICENSED",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/jpnqs/aem-suite.git"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@cap-js-community/websocket": "^1.11.2",
    "@cap-js/hana": "^3.1.2",
    "@cap-js/mcp": "^1.5.0",
    "@faker-js/faker": "^9.9.0",
    "@sap-cloud-sdk/connectivity": "^4.9.1",
    "@sap/cds": "^10.1.1",
    "@sap/xssec": "^4.15.0",
    "express": "^5.3.0",
    "markdown-it": "^15.0.2",
    "solclientjs": "^10.18.3"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1.0.2",
    "@cap-js/cds-typer": "^0.41.1",
    "@cap-js/cds-types": "^0.20.0",
    "@cap-js/sqlite": "^3.1.2",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.63.0",
    "@sap/cds-dk": "^10.1.0",
    "@sapui5/types": "1.148.12",
    "@types/jest": "^30.0.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "@ui5/cli": "^4.0.71",
    "cds-plugin-ui5": "^0.17.4",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "jest": "^30.5.2",
    "mbt": "^1.2.49",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "ui5-task-zipper": "^3.7.0",
    "ui5-tooling-transpile": "^3.13.1",
    "ws": "^8.22.0",
    "yaml": "^2.9.1"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds-tsx w",
    "before:cds-watch": "cds-typer \"*\"",
    "typer": "cds-typer \"*\"",
    "typecheck": "npm run typer --silent && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p app/subscriber && tsc --noEmit -p app/testcases && tsc --noEmit -p e2e",
    "lint": "eslint .",
    "pretest": "npm run typer --silent",
    "test": "jest",
    "verify": "npm run typecheck && npm run lint && npm test",
    "e2e": "playwright test",
    "docs:screenshots": "playwright test -c playwright.screenshots.config.ts",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:trace": "playwright show-trace",
    "build:ui": "node scripts/build-ui.js",
    "build:docs": "node scripts/build-docs.js",
    "build": "mbt build --mtar aem-suite.mtar",
    "deploy": "cf deploy mta_archives/aem-suite.mtar",
    "set-version": "node scripts/set-version.js"
  },
  "imports": {
    "#cds-models/*": "./@cds-models/*/index.js"
  },
  "cds": {
    "log": {
      "levels": {
        "odata": "warn",
        "sql": "warn",
        "db": "warn"
      }
    },
    "requires": {
      "auth": "xsuaa",
      "[development]": {
        "auth": {
          "kind": "mocked",
          "users": {
            "admin": {
              "password": "admin",
              "roles": [
                "Admin",
                "Tester"
              ]
            },
            "tester": {
              "password": "tester",
              "roles": [
                "Tester"
              ]
            },
            "*": false
          }
        }
      },
      "[test]": {
        "auth": {
          "users": {
            "norole": {
              "password": "norole",
              "roles": []
            }
          }
        }
      },
      "destinations": true
    },
    "mcp": {
      "autowire": false,
      "prefix": true
    },
    "websocket": {
      "kind": "ws"
    },
    "sql": {
      "native_hana_associations": false
    },
    "fiori": {
      "draft_messages": false
    }
  }
}
