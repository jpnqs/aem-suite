{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "allowJs": true,
    "outDir": "./gen/srv",
    "rootDir": ".",
    "types": [
      "node",
      "@cap-js/cds-types"
    ],
    "paths": {
      "#cds-models/*": [
        "./@cds-models/*"
      ]
    }
  },
  "include": [
    "srv/**/*.ts",
    "@cds-models/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "gen",
    "app"
  ]
}
