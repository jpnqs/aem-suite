{
  "_version": "1.65.0",
  "sap.app": {
    "id": "com.aem.suite.testcases",
    "type": "application",
    "i18n": {
      "bundleUrl": "i18n/i18n.properties",
      "supportedLocales": [
        ""
      ],
      "fallbackLocale": ""
    },
    "applicationVersion": {
      "version": "1.0.0"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/test/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "intent": {
          "semanticObject": "AEMSuiteTestCases",
          "action": "manage",
          "title": "{{appTitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.148.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {},
        "sap.ui.codeeditor": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "com.aem.suite.testcases.i18n.i18n",
          "supportedLocales": [
            ""
          ],
          "fallbackLocale": ""
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "TestCasesList",
          "target": "TestCasesList"
        },
        {
          "pattern": "TestCases({key}):?query:",
          "name": "TestCasesObjectPage",
          "target": "TestCasesObjectPage"
        }
      ],
      "targets": {
        "TestCasesList": {
          "type": "Component",
          "id": "TestCasesList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/TestCases",
              "variantManagement": "Page",
              "initialLoad": "Enabled",
              "content": {
                "header": {
                  "actions": {
                    "help": {
                      "press": "com.aem.suite.testcases.ext.Help.openForList",
                      "text": "Help"
                    }
                  }
                }
              },
              "navigation": {
                "TestCases": {
                  "detail": {
                    "route": "TestCasesObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "columns": {
                    "typeIcon": {
                      "header": "Type",
                      "template": "com.aem.suite.testcases.ext.TypeColumn",
                      "width": "5rem",
                      "horizontalAlign": "Center",
                      "properties": [
                        "kind"
                      ],
                      "position": {
                        "placement": "After",
                        "anchor": "DataField::name"
                      }
                    }
                  },
                  "tableSettings": {
                    "type": "TreeTable",
                    "hierarchyQualifier": "TestTree",
                    "selectionMode": "Multi",
                    "isMoveToPositionAllowed": "com.aem.suite.testcases.ext.TreeRules.isMoveToPositionAllowed",
                    "creationMode": {
                      "name": "NewPage",
                      "isCreateEnabled": "com.aem.suite.testcases.ext.TreeRules.isCreateEnabled",
                      "nodeType": {
                        "propertyName": "kind",
                        "values": {
                          "FOLDER": "Folder",
                          "TEST": "Test Case"
                        }
                      }
                    }
                  },
                  "actions": {
                    "runSelected": {
                      "press": "com.aem.suite.testcases.ext.TestCaseActions.runSelected",
                      "text": "Run…",
                      "requiresSelection": true
                    },
                    "copySelected": {
                      "press": "com.aem.suite.testcases.ext.TestCaseActions.copySelected",
                      "text": "Copy",
                      "requiresSelection": true
                    },
                    "exportSelected": {
                      "press": "com.aem.suite.testcases.ext.TestCaseActions.exportSelected",
                      "text": "Export",
                      "requiresSelection": false
                    },
                    "importFile": {
                      "press": "com.aem.suite.testcases.ext.TestCaseActions.importFile",
                      "text": "Import",
                      "requiresSelection": false
                    }
                  }
                }
              }
            }
          }
        },
        "TestCasesObjectPage": {
          "type": "Component",
          "id": "TestCasesObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/TestCases",
              "content": {
                "header": {
                  "actions": {
                    "runThis": {
                      "press": "com.aem.suite.testcases.ext.TestCaseActions.runFromObjectPage",
                      "text": "Run…",
                      "visible": "{= ${IsActiveEntity} === true }"
                    },
                    "copy": {
                      "press": "com.aem.suite.testcases.ext.TestCaseActions.copyFromObjectPage",
                      "text": "Copy",
                      "visible": "{= ${IsActiveEntity} === true }"
                    },
                    "export": {
                      "press": "com.aem.suite.testcases.ext.TestCaseActions.exportFromObjectPage",
                      "text": "Export",
                      "visible": "{= ${IsActiveEntity} === true }"
                    },
                    "help": {
                      "press": "com.aem.suite.testcases.ext.Help.openForObjectPage",
                      "text": "Help"
                    },
                    "preview": {
                      "press": "com.aem.suite.testcases.ext.TestCaseActions.preview",
                      "text": "Preview"
                    }
                  }
                },
                "body": {
                  "sections": {
                    "message": {
                      "template": "com.aem.suite.testcases.ext.MessageSection",
                      "title": "Message",
                      "position": {
                        "placement": "Before",
                        "anchor": "AdvancedSection"
                      }
                    },
                    "payload": {
                      "template": "com.aem.suite.testcases.ext.PayloadSection",
                      "title": "Payload",
                      "position": {
                        "placement": "After",
                        "anchor": "message"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "extends": {
      "extensions": {
        "sap.ui.controllerExtensions": {
          "sap.fe.templates.ObjectPage.ObjectPageController#com.aem.suite.testcases::TestCasesObjectPage": {
            "controllerName": "com.aem.suite.testcases.ext.ObjectPageExt"
          },
          "sap.fe.templates.ListReport.ListReportController#com.aem.suite.testcases::TestCasesList": {
            "controllerName": "com.aem.suite.testcases.ext.MyEntriesFilter"
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  }
}
