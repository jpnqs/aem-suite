<core:FragmentDefinition
  xmlns:core="sap.ui.core"
  xmlns="sap.m"
  xmlns:ce="sap.ui.codeeditor">
  <VBox
    core:require="{handler: 'com/aem/suite/testcases/ext/PayloadSection'}"
    width="100%">
    <OverflowToolbar style="Clear">
      <ObjectStatus
        text="{parts: ['payload', 'aem>/typedPayload', 'i18n>payload.valid', 'i18n>payload.empty', 'i18n>payload.invalid'], formatter: 'handler.statusText'}"
        state="{parts: ['payload', 'aem>/typedPayload'], formatter: 'handler.statusState'}"
        icon="{parts: ['payload', 'aem>/typedPayload'], formatter: 'handler.statusIcon'}" />
      <ToolbarSpacer />
      <Button
        icon="sap-icon://sys-help"
        tooltip="{i18n>payload.templateVariablesAndBuiltIns}"
        type="Transparent"
        press="handler.onHelp" />
      <Button
        text="{i18n>payload.format}"
        icon="sap-icon://indent"
        enabled="{ui>/isEditable}"
        press="handler.onFormat" />
    </OverflowToolbar>
    <ce:CodeEditor
      id="payloadEditor"
      type="json"
      value="{payload}"
      editable="{ui>/isEditable}"
      height="420px"
      width="100%"
      lineNumbers="true"
      syntaxHints="false"
      liveChange="handler.onLiveChange"
      modelContextChange="handler.onEditorContext" />
  </VBox>
</core:FragmentDefinition>
