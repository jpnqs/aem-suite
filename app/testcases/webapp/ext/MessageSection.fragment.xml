<core:FragmentDefinition
  xmlns:core="sap.ui.core"
  xmlns="sap.m">
  <VBox
    core:require="{handler: 'com/aem/suite/testcases/ext/MessageSection'}"
    width="100%">
    <Label text="Topic" required="{ui>/isEditable}" design="Bold" visible="{= !${aem>/isFolder} }" />
    <TextArea
      value="{topic}"
      visible="{= ${ui>/isEditable} &amp;&amp; !${aem>/isFolder} }"
      width="100%"
      rows="2"
      growing="true"
      growingMaxLines="8"
      placeholder="e.g. acme/orders/\{\{region\}\}/created/v1/\{\{uuid\}\}"
      change="handler.onTopicChange" />
    <Text text="{topic}" visible="{= !${ui>/isEditable} &amp;&amp; !${aem>/isFolder} }" wrapping="true" renderWhitespace="true" />

    <Label
      text="{= ${aem>/isFolder} ? 'Folder name' : 'Name' }"
      required="{= ${ui>/isEditable} &amp;&amp; ${aem>/isFolder} }"
      design="{= ${aem>/isFolder} ? 'Bold' : 'Standard' }"
      class="sapUiSmallMarginTop" />
    <Input
      value="{name}"
      visible="{ui>/isEditable}"
      width="100%"
      placeholder="{= ${aem>/isFolder} ? 'e.g. Orders' : 'Empty = topic' }" />
    <Text text="{name}" visible="{= !${ui>/isEditable} }" wrapping="true" />
  </VBox>
</core:FragmentDefinition>
