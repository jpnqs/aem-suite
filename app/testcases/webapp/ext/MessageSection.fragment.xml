<core:FragmentDefinition
  xmlns:core="sap.ui.core"
  xmlns="sap.m">
  <VBox
    core:require="{handler: 'com/aem/suite/testcases/ext/MessageSection'}"
    width="100%">
    <Label text="{i18n>preview.topic}" required="{ui>/isEditable}" design="Bold" visible="{= !${aem>/isFolder} }" />
    <TextArea
      value="{topic}"
      visible="{= ${ui>/isEditable} &amp;&amp; !${aem>/isFolder} }"
      width="100%"
      rows="2"
      growing="true"
      growingMaxLines="8"
      placeholder="{i18n>message.eGAcmeOrdersRegionCreated}"
      change="handler.onTopicChange" />
    <Text text="{topic}" visible="{= !${ui>/isEditable} &amp;&amp; !${aem>/isFolder} }" wrapping="true" renderWhitespace="true" />

    <Label
      text="{= ${aem>/isFolder} ? ${i18n>message.folderName} : ${i18n>message.name} }"
      required="{= ${ui>/isEditable} &amp;&amp; ${aem>/isFolder} }"
      design="{= ${aem>/isFolder} ? 'Bold' : 'Standard' }"
      class="sapUiSmallMarginTop" />
    <Input
      value="{name}"
      visible="{ui>/isEditable}"
      width="100%"
      placeholder="{= ${aem>/isFolder} ? ${i18n>message.folderPlaceholder} : ${i18n>message.namePlaceholder} }" />
    <Text text="{name}" visible="{= !${ui>/isEditable} }" wrapping="true" />
  </VBox>
</core:FragmentDefinition>
