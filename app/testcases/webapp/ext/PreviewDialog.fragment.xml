<core:FragmentDefinition
  xmlns:core="sap.ui.core"
  xmlns="sap.m"
  xmlns:f="sap.ui.layout.form"
  xmlns:ce="sap.ui.codeeditor">
  <Dialog
    title="{i18n>preview.previewResolvedMessage}"
    contentWidth="48rem"
    contentHeight="70%"
    resizable="true"
    draggable="true">
    <content>
      <VBox class="sapUiSmallMargin">
        <HBox alignItems="Center">
          <Label text="{i18n>preview.resolveForBroker}" labelFor="previewBroker" class="sapUiSmallMarginEnd" />
          <Select
            id="previewBroker"
            forceSelection="false"
            selectedKey="{preview>/brokerId}"
            items="{path: '/Brokers', sorter: {path: 'name'}, templateShareable: false}"
            change=".onResolve">
            <core:Item key="{ID}" text="{name}" />
          </Select>
          <Button text="{i18n>preview.resolve}" icon="sap-icon://refresh" press=".onResolve" class="sapUiSmallMarginBegin" />
        </HBox>
        <MessageStrip
          text="{preview>/message}"
          type="{= ${preview>/valid} ? 'Success' : 'Error' }"
          visible="{= !!${preview>/message} }"
          showIcon="true"
          class="sapUiSmallMarginTopBottom" />
        <f:SimpleForm editable="false" layout="ResponsiveGridLayout" labelSpanM="3" visible="{preview>/valid}">
          <Label text="{i18n>preview.topic}" />
          <Text text="{preview>/topic}" />
          <Label text="{i18n>preview.correlationID}" />
          <Text text="{preview>/correlationId}" />
        </f:SimpleForm>
        <Title text="{i18n>section.payload}" level="H5" visible="{preview>/valid}" class="sapUiTinyMarginTop" />
        <ce:CodeEditor type="json" value="{preview>/payload}" editable="false" height="260px" visible="{preview>/valid}" />
        <Title text="{i18n>preview.userProperties}" level="H5" visible="{preview>/valid}" class="sapUiTinyMarginTop" />
        <ce:CodeEditor type="json" value="{preview>/userProperties}" editable="false" height="100px" visible="{preview>/valid}" />
      </VBox>
    </content>
    <endButton>
      <Button text="{i18n>preview.close}" press=".onClose" />
    </endButton>
  </Dialog>
</core:FragmentDefinition>
