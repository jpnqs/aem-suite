<core:FragmentDefinition
  xmlns:core="sap.ui.core"
  xmlns="sap.m"
  xmlns:rte="sap.ui.richtexteditor">
  <!--
    The documentation of a test case or folder. Stored as Markdown (description); edited in a rich text editor and
    shown as HTML (descriptionHtml - the server converts both ways, srv/lib/testcases/documentation.ts).
  -->
  <VBox
    core:require="{handler: 'com/aem/suite/testcases/ext/DocumentationSection'}"
    width="100%">
    <OverflowToolbar style="Clear">
      <ToolbarSpacer />
      <Button
        text="{i18n>documentation.export}"
        icon="sap-icon://download"
        enabled="{path: 'description', targetType: 'any', formatter: 'handler.hasText'}"
        press="handler.onExport" />
    </OverflowToolbar>
    <rte:RichTextEditor
      value="{descriptionHtml}"
      visible="{ui>/isEditable}"
      width="100%"
      height="420px"
      customToolbar="true"
      useLegacyTheme="false"
      showGroupFont="false"
      showGroupTextAlign="false"
      showGroupInsert="false"
      showGroupClipboard="false"
      placeholder="{i18n>documentation.placeholder}"
      modelContextChange="handler.onEditorContext"
      readyRecurring="handler.onReady" />
    <core:HTML
      content="{path: 'descriptionHtml', formatter: 'handler.asHtml'}"
      sanitizeContent="true"
      visible="{parts: ['ui>/isEditable', {path: 'descriptionHtml', targetType: 'any'}], formatter: 'handler.showsDocumentation'}" />
    <Text text="{i18n>documentation.empty}" visible="{parts: ['ui>/isEditable', {path: 'descriptionHtml', targetType: 'any'}], formatter: 'handler.showsEmpty'}" class="sapThemeMetaText" />
  </VBox>
</core:FragmentDefinition>
