<core:FragmentDefinition
  xmlns:core="sap.ui.core"
  xmlns="sap.m">
  <Dialog
    title="{i18n>run.title} {run>/label}"
    contentWidth="38rem"
    resizable="true"
    draggable="true">
    <content>
      <VBox class="sapUiSmallMargin" visible="{= !${run>/runId} }">
        <Text text="{i18n>run.selectTheBrokersToRunAgainst}" class="sapUiTinyMarginBottom" />
        <Link text="{i18n>run.howDoRunsWorkAndWhat}" press=".onHelp" class="sapUiSmallMarginBottom" />
        <List
          id="brokerList"
          mode="MultiSelect"
          includeItemInSelection="true"
          noDataText="{i18n>run.noActiveBrokersMaintainBrokersFirst}"
          updateFinished=".onBrokersLoaded"
          selectionChange=".onBrokerSelection"
          items="{path: '/Brokers', parameters: {$select: 'username,credentialMode'}, sorter: {path: 'name'}, templateShareable: false}">
          <StandardListItem
            title="{name}"
            description="{= ${credentialMode} === 'DESTINATION' ? ${i18n>run.btpDestination} : (${username} ? ${username} + ' @ ' + ${msgVpn} : ${i18n>run.vpn} + ' ' + ${msgVpn}) }"
            info="{lastConnectionStatus}"
            infoState="{= ${lastConnectionStatus} === 'OK' ? 'Success' : ${lastConnectionStatus} === 'ERROR' ? 'Error' : 'None' }" />
        </List>
        <VBox visible="{= ${run>/credentials}.length > 0 }" class="sapUiSmallMarginTop">
          <Title text="{i18n>run.credentialsUsedForThisRunOnly}" level="H6" />
          <List items="{path: 'run>/credentials', templateShareable: false}" showSeparators="None">
            <CustomListItem>
              <HBox alignItems="Center" class="sapUiTinyMarginTopBottom">
                <Label text="{= ${run>username} ? ${run>name} + ' (' + ${run>username} + ')' : ${run>name} }" width="12rem" wrapping="true" />
                <Input
                  visible="{run>needsUsername}"
                  value="{run>enteredUsername}"
                  valueLiveUpdate="true"
                  valueState="{= ${run>missing} &amp;&amp; !${run>enteredUsername} ? 'Error' : 'None' }"
                  placeholder="{i18n>run.username}"
                  width="11rem"
                  class="sapUiTinyMarginEnd"
                  submit=".onPrimary" />
                <Input
                  type="Password"
                  value="{run>password}"
                  valueLiveUpdate="true"
                  valueState="{= ${run>missing} &amp;&amp; !${run>password} ? 'Error' : 'None' }"
                  placeholder="{i18n>run.password}"
                  width="11rem"
                  submit=".onPrimary" />
              </HBox>
            </CustomListItem>
          </List>
        </VBox>
        <Panel
          headerText="{i18n>run.advancedSettings}"
          expandable="true"
          expanded="false"
          class="sapUiNoContentPadding sapUiSmallMarginTop">
          <content>
            <VBox class="sapUiSmallMargin">
              <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                <Label text="{i18n>run.repetitions}" width="14rem" tooltip="{i18n>run.howOftenEveryTestCaseIs}" />
                <StepInput value="{run>/repetitions}" min="1" max="1000" width="9rem" change=".onOptionsChange" />
              </HBox>
              <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                <Label text="{i18n>run.pauseBetweenMessages}" width="14rem" tooltip="{i18n>run.waitBetweenTwoMessagesToThe}" />
                <StepInput value="{run>/delayMs}" min="0" max="60000" step="100" largerStep="1000" displayValuePrecision="0" description="ms" fieldWidth="60%" width="11rem" change=".onOptionsChange" />
              </HBox>
              <HBox alignItems="Center" class="sapUiTinyMarginBottom" visible="{= ${run>/repetitions} > 1 }">
                <Label text="{i18n>run.order}" width="14rem" tooltip="{i18n>run.wholeSelectionABCA}" />
                <SegmentedButton selectedKey="{run>/order}" width="20rem">
                  <items>
                    <SegmentedButtonItem key="ROUND" text="{i18n>run.wholeSelection}" />
                    <SegmentedButtonItem key="EACH" text="{i18n>run.eachTestCase}" />
                  </items>
                </SegmentedButton>
              </HBox>
              <CheckBox
                text="{i18n>run.stopAtTheFirstFailure}"
                selected="{run>/stopOnFailure}"
                tooltip="{i18n>run.afterAMessageFailedTheRest}" />
              <Text text="{run>/estimate}" class="sapUiTinyMarginTop" />
            </VBox>
          </content>
        </Panel>
      </VBox>
      <VBox class="sapUiSmallMargin" visible="{= !!${run>/runId} }">
        <MessageStrip
          visible="{= ${run>/connectionLost} &amp;&amp; !${run>/finished} }"
          text="{i18n>run.liveProgressConnectionLostReconnectingMeanwhile}"
          type="Warning"
          showIcon="true"
          class="sapUiSmallMarginBottom" />
        <ObjectStatus
          text="{= ${run>/finished} ? (${run>/aborted} ? ${i18n>run.aborted} : (${run>/skipped} > 0 ? ${i18n>run.finished} + ' - ' + ${run>/skipped} + ' ' + ${i18n>run.notSent} : ${i18n>run.finished})) : (${run>/stopping} ? ${i18n>run.stopping} : ${i18n>run.running}) }"
          state="{= ${run>/finished} ? (${run>/failed} > 0 ? 'Error' : (${run>/skipped} > 0 ? 'Warning' : 'Success')) : 'Information' }"
          icon="{= ${run>/finished} ? (${run>/failed} > 0 ? 'sap-icon://error' : 'sap-icon://sys-enter-2') : 'sap-icon://pending' }"
          class="sapMObjectStatusLarge sapUiSmallMarginBottom" />
        <ProgressIndicator
          percentValue="{= ${run>/total} ? Math.round(${run>/done} * 100 / ${run>/total}) : 0 }"
          displayValue="{run>/done} / {run>/total}"
          state="{= ${run>/failed} > 0 ? 'Error' : 'Success' }"
          showValue="true" />
        <HBox class="sapUiSmallMarginTop">
          <ObjectNumber number="{run>/passed}" unit="passed" state="Success" class="sapUiMediumMarginEnd" />
          <ObjectNumber number="{run>/failed}" unit="{i18n>run.failedError}" state="{= ${run>/failed} > 0 ? 'Error' : 'None' }" class="sapUiMediumMarginEnd" />
          <ObjectNumber number="{run>/skipped}" unit="{i18n>run.notSent}" state="Warning" visible="{= ${run>/skipped} > 0 }" />
        </HBox>
        <Button
          text="{i18n>run.stopRun}"
          icon="sap-icon://stop"
          type="Reject"
          class="sapUiSmallMarginTop"
          visible="{= !${run>/finished} }"
          enabled="{= !${run>/stopping} }"
          tooltip="{i18n>run.stopsTheRunMessagesNotSent}"
          press=".onStop" />
        <List
          visible="{= ${run>/problems}.length > 0 }"
          items="{path: 'run>/problems', templateShareable: false}"
          headerText="{i18n>run.problems}"
          class="sapUiSmallMarginTop">
          <StandardListItem
            title="{run>testCaseName} @ {run>brokerName}"
            description="{run>errorMessage}"
            info="{run>status}"
            infoState="Error"
            wrapping="true" />
        </List>
        <Text
          visible="{= ${run>/moreProblems} > 0 }"
          text="{i18n>run.moreProblemsBefore} {run>/moreProblems} {i18n>run.moreProblemsAfter}"
          class="sapUiTinyMarginTop" />
      </VBox>
    </content>
    <beginButton>
      <Button
        text="{= ${run>/runId} ? ${i18n>run.openResults} : ${i18n>run.run} }"
        type="Emphasized"
        enabled="{= !${run>/starting} }"
        press=".onPrimary" />
    </beginButton>
    <endButton>
      <Button text="{i18n>preview.close}" press=".onClose" />
    </endButton>
  </Dialog>
</core:FragmentDefinition>
