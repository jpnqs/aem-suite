<core:FragmentDefinition
  xmlns:core="sap.ui.core"
  xmlns="sap.m">
  <Dialog
    title="Run {run>/label}"
    contentWidth="38rem"
    resizable="true"
    draggable="true">
    <content>
      <VBox class="sapUiSmallMargin" visible="{= !${run>/runId} }">
        <Text text="Select the brokers to run against. Each selected test case is published once per broker." class="sapUiTinyMarginBottom" />
        <Link text="How do runs work, and what do the results mean?" press=".onHelp" class="sapUiSmallMarginBottom" />
        <List
          id="brokerList"
          mode="MultiSelect"
          includeItemInSelection="true"
          noDataText="No active brokers - maintain brokers first"
          updateFinished=".onBrokersLoaded"
          selectionChange=".onBrokerSelection"
          items="{path: '/Brokers', parameters: {$select: 'username,credentialMode'}, sorter: {path: 'name'}, templateShareable: false}">
          <StandardListItem
            title="{name}"
            description="{= ${credentialMode} === 'DESTINATION' ? 'BTP destination' : (${username} ? ${username} + ' @ ' + ${msgVpn} : 'VPN ' + ${msgVpn}) }"
            info="{lastConnectionStatus}"
            infoState="{= ${lastConnectionStatus} === 'OK' ? 'Success' : ${lastConnectionStatus} === 'ERROR' ? 'Error' : 'None' }" />
        </List>
        <VBox visible="{= ${run>/credentials}.length > 0 }" class="sapUiSmallMarginTop">
          <Title text="Credentials (used for this run only, not stored)" level="H6" />
          <List items="{path: 'run>/credentials', templateShareable: false}" showSeparators="None">
            <CustomListItem>
              <HBox alignItems="Center" class="sapUiTinyMarginTopBottom">
                <Label text="{= ${run>username} ? ${run>name} + ' (' + ${run>username} + ')' : ${run>name} }" width="12rem" wrapping="true" />
                <Input
                  visible="{run>needsUsername}"
                  value="{run>enteredUsername}"
                  valueLiveUpdate="true"
                  valueState="{= ${run>missing} &amp;&amp; !${run>enteredUsername} ? 'Error' : 'None' }"
                  placeholder="Username"
                  width="11rem"
                  class="sapUiTinyMarginEnd"
                  submit=".onPrimary" />
                <Input
                  type="Password"
                  value="{run>password}"
                  valueLiveUpdate="true"
                  valueState="{= ${run>missing} &amp;&amp; !${run>password} ? 'Error' : 'None' }"
                  placeholder="Password"
                  width="11rem"
                  submit=".onPrimary" />
              </HBox>
            </CustomListItem>
          </List>
        </VBox>
        <Panel
          headerText="Advanced settings"
          expandable="true"
          expanded="false"
          class="sapUiNoContentPadding sapUiSmallMarginTop">
          <content>
            <VBox class="sapUiSmallMargin">
              <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                <Label text="Repetitions" width="14rem" tooltip="How often every test case is sent to every selected broker" />
                <StepInput value="{run>/repetitions}" min="1" max="1000" width="9rem" change=".onOptionsChange" />
              </HBox>
              <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                <Label text="Pause between messages" width="14rem" tooltip="Wait between two messages to the same broker (not before the first)" />
                <StepInput value="{run>/delayMs}" min="0" max="60000" step="100" largerStep="1000" displayValuePrecision="0" description="ms" fieldWidth="60%" width="11rem" change=".onOptionsChange" />
              </HBox>
              <HBox alignItems="Center" class="sapUiTinyMarginBottom" visible="{= ${run>/repetitions} > 1 }">
                <Label text="Order" width="14rem" tooltip="Whole selection: a b c, a b c, ...   Each test case: a a a, b b b, ..." />
                <SegmentedButton selectedKey="{run>/order}" width="20rem">
                  <items>
                    <SegmentedButtonItem key="ROUND" text="Whole selection" />
                    <SegmentedButtonItem key="EACH" text="Each test case" />
                  </items>
                </SegmentedButton>
              </HBox>
              <CheckBox
                text="Stop at the first failure"
                selected="{run>/stopOnFailure}"
                tooltip="After a message failed, the rest of that broker is skipped. Other brokers go on." />
              <Text text="{run>/estimate}" class="sapUiTinyMarginTop" />
            </VBox>
          </content>
        </Panel>
      </VBox>
      <VBox class="sapUiSmallMargin" visible="{= !!${run>/runId} }">
        <MessageStrip
          visible="{= ${run>/connectionLost} &amp;&amp; !${run>/finished} }"
          text="Live progress connection lost - reconnecting. Meanwhile the dialog checks every few seconds whether the run has finished."
          type="Warning"
          showIcon="true"
          class="sapUiSmallMarginBottom" />
        <ObjectStatus
          text="{= ${run>/finished} ? (${run>/aborted} ? 'Aborted - see the problems below' : (${run>/skipped} > 0 ? 'Finished - ' + ${run>/skipped} + ' not sent' : 'Finished')) : (${run>/stopping} ? 'Stopping…' : 'Running…') }"
          state="{= ${run>/finished} ? (${run>/failed} > 0 ? 'Error' : (${run>/skipped} > 0 ? 'Warning' : 'Success')) : 'Information' }"
          icon="{= ${run>/finished} ? (${run>/failed} > 0 ? 'sap-icon://error' : 'sap-icon://sys-enter-2') : 'sap-icon://pending' }"
          class="sapMObjectStatusLarge sapUiSmallMarginBottom" />
        <ProgressIndicator
          percentValue="{= ${run>/total} ? Math.round(${run>/done} * 100 / ${run>/total}) : 0 }"
          displayValue="{run>/done} / {run>/total}"
          state="{= ${run>/failed} > 0 ? 'Error' : 'Success' }"
          showValue="true" />
        <HBox class="sapUiSmallMarginTop">
          <ObjectNumber number="{run>/passed}" unit="passed" state="Success" class="sapUiMediumMarginEnd" />
          <ObjectNumber number="{run>/failed}" unit="failed / error" state="{= ${run>/failed} > 0 ? 'Error' : 'None' }" class="sapUiMediumMarginEnd" />
          <ObjectNumber number="{run>/skipped}" unit="not sent" state="Warning" visible="{= ${run>/skipped} > 0 }" />
        </HBox>
        <Button
          text="Stop run"
          icon="sap-icon://stop"
          type="Reject"
          class="sapUiSmallMarginTop"
          visible="{= !${run>/finished} }"
          enabled="{= !${run>/stopping} }"
          tooltip="Stops the run: messages not sent yet are skipped"
          press=".onStop" />
        <List
          visible="{= ${run>/problems}.length > 0 }"
          items="{path: 'run>/problems', templateShareable: false}"
          headerText="Problems"
          class="sapUiSmallMarginTop">
          <StandardListItem
            title="{run>testCaseName} @ {run>brokerName}"
            description="{run>errorMessage}"
            info="{run>status}"
            infoState="Error"
            wrapping="true" />
        </List>
        <Text
          visible="{= ${run>/moreProblems} > 0 }"
          text="… and {run>/moreProblems} more - see all of them with Open Results."
          class="sapUiTinyMarginTop" />
      </VBox>
    </content>
    <beginButton>
      <Button
        text="{= ${run>/runId} ? 'Open Results' : 'Run' }"
        type="Emphasized"
        enabled="{= !${run>/starting} }"
        press=".onPrimary" />
    </beginButton>
    <endButton>
      <Button text="Close" press=".onClose" />
    </endButton>
  </Dialog>
</core:FragmentDefinition>
