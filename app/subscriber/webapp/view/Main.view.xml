<mvc:View
  controllerName="com.aem.suite.subscriber.controller.Main"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:core="sap.ui.core"
  xmlns="sap.m"
  xmlns:f="sap.f"
  xmlns:l="sap.ui.layout"
  xmlns:ce="sap.ui.codeeditor"
  displayBlock="true"
  height="100%">
  <f:DynamicPage
    id="page"
    class="aemPage sapUiResponsiveContentPadding"
    toggleHeaderOnTitleClick="true"
    fitContent="true">
    <f:title>
      <f:DynamicPageTitle>
        <f:heading>
          <HBox alignItems="Center">
            <core:Icon src="sap-icon://feeder-arrow" size="1.5rem" color="Default" class="sapUiSmallMarginEnd aemTitleIcon" />
            <Title text="{i18n>view.liveSubscriber}" />
            <ObjectStatus
              text="{state>/status}"
              state="{= ${state>/subscriptionId} ? 'Success' : 'None' }"
              inverted="{= !!${state>/subscriptionId} }"
              icon="{= ${state>/subscriptionId} ? 'sap-icon://connected' : 'sap-icon://disconnected' }"
              class="sapUiMediumMarginBegin aemStatus" />
            <ObjectNumber
              number="{state>/received}"
              unit="{i18n>view.messagesUnit}"
              visible="{= !!${state>/subscriptionId} || ${state>/received} > 0 }"
              class="sapUiSmallMarginBegin aemStatus" />
            <ObjectStatus
              text="{i18n>view.websocketOffline}"
              state="Warning"
              icon="sap-icon://alert"
              visible="{= !${state>/socketConnected} }"
              class="sapUiSmallMarginBegin aemStatus" />
          </HBox>
        </f:heading>
        <f:expandedContent>
          <Text text="{i18n>view.listenToTopicsOrQueuesAnd}" />
        </f:expandedContent>
        <f:snappedContent>
          <HBox alignItems="Center" wrap="Wrap">
            <ObjectStatus text="{state>/brokerName}" icon="sap-icon://chain-link" class="sapUiSmallMarginEnd" />
            <Text text="{state>/sourceLabel}" class="aemMono" maxLines="1" />
          </HBox>
        </f:snappedContent>
        <f:actions>
          <Button
            text="{i18n>view.start}"
            type="Emphasized"
            icon="sap-icon://media-play"
            enabled="{= !${state>/subscriptionId} &amp;&amp; !${state>/busy} }"
            press=".onStart" />
          <Button
            text="{i18n>view.stop}"
            type="{= ${state>/subscriptionId} ? 'Reject' : 'Default' }"
            icon="sap-icon://stop"
            enabled="{= !!${state>/subscriptionId} &amp;&amp; !${state>/busy} }"
            press=".onStop" />
          <Button
            text="{i18n>view.activeSubscriptions}"
            type="Transparent"
            icon="sap-icon://list"
            press=".onShowActive" />
          <Button
            text="{i18n>view.help}"
            type="Transparent"
            icon="sap-icon://sys-help"
            press=".onHelp" />
        </f:actions>
      </f:DynamicPageTitle>
    </f:title>
    <f:header>
      <f:DynamicPageHeader pinnable="false">
        <VBox class="aemConnect">
          <l:Grid defaultSpan="XL3 L4 M6 S12" hSpacing="1" vSpacing="0.5" containerQuery="true">
            <VBox>
              <layoutData>
                <l:GridData span="XL12 L12 M12 S12" />
              </layoutData>
              <Label text="{i18n>view.savedSetup}" labelFor="preset" tooltip="{i18n>view.brokerSourceTopicsQueueAndUsername}" />
              <HBox alignItems="Center">
                <Select
                  id="preset"
                  width="20rem"
                  forceSelection="false"
                  selectedKey="{state>/presetId}"
                  enabled="{= !${state>/subscriptionId} }"
                  change=".onPresetChange"
                  items="{path: '/SubscriberPresets', sorter: {path: 'name'}}">
                  <core:Item key="{ID}" text="{name}" />
                </Select>
                <Button
                  icon="sap-icon://save"
                  text="{i18n>view.saveAs}"
                  type="Transparent"
                  class="sapUiTinyMarginBegin"
                  tooltip="{i18n>view.saveTheCurrentBrokerSourceTopics}"
                  press=".onSavePreset" />
                <Button
                  icon="sap-icon://delete"
                  type="Transparent"
                  enabled="{= !!${state>/presetId} }"
                  tooltip="{i18n>view.deleteTheSelectedSetup}"
                  press=".onDeletePreset" />
              </HBox>
            </VBox>
            <VBox>
              <Label text="{i18n>view.broker}" labelFor="broker" required="true" />
              <Select
                id="broker"
                width="100%"
                forceSelection="false"
                selectedKey="{state>/brokerId}"
                enabled="{= !${state>/subscriptionId} }"
                change=".onBrokerChange"
                items="{path: '/Brokers', sorter: {path: 'name'}}">
                <core:Item key="{ID}" text="{name}" />
              </Select>
            </VBox>
            <VBox visible="{state>/needsUsername}">
              <Label text="{i18n>view.username}" required="true" tooltip="{i18n>view.notMaintainedOnTheBroker}" />
              <Input
                width="100%"
                value="{state>/enteredUsername}"
                placeholder="{i18n>view.notMaintainedOnTheBroker}"
                enabled="{= !${state>/subscriptionId} }"
                submit=".onStart" />
            </VBox>
            <VBox visible="{state>/needsPassword}">
              <Label text="{= ${state>/username} ? ${i18n>view.passwordFor} + ' ' + ${state>/username} : ${i18n>view.password} }" required="true" />
              <Input
                type="Password"
                width="100%"
                value="{state>/password}"
                placeholder="{i18n>view.notStored}"
                enabled="{= !${state>/subscriptionId} }"
                submit=".onStart" />
            </VBox>
            <VBox>
              <Label text="{i18n>view.source}" />
              <SegmentedButton
                width="100%"
                selectedKey="{state>/sourceType}"
                enabled="{= !${state>/subscriptionId} }">
                <items>
                  <SegmentedButtonItem key="TOPIC" text="{i18n>view.topics}" icon="sap-icon://feeder-arrow" />
                  <SegmentedButtonItem key="QUEUE_BROWSE" text="{i18n>view.browseQueue}" icon="sap-icon://show" />
                  <SegmentedButtonItem key="QUEUE_CONSUME" text="{i18n>view.consumeQueue}" icon="sap-icon://download" />
                </items>
              </SegmentedButton>
            </VBox>
            <VBox visible="{= ${state>/sourceType} === 'TOPIC' }">
              <layoutData>
                <l:GridData span="XL12 L12 M12 S12" />
              </layoutData>
              <Label text="{i18n>view.topicSubscriptions}" labelFor="topics" required="true" />
              <HBox>
                <Input
                  id="topics"
                  width="100%"
                  placeholder="{i18n>view.addATopicEGAcme}"
                  enabled="{= !${state>/subscriptionId} }"
                  showSuggestion="true"
                  suggestionItems="{path: 'state>/topicHistory', templateShareable: false}"
                  suggestionItemSelected=".onAddTopic"
                  liveChange=".onTopicLiveChange"
                  submit=".onAddTopic">
                  <suggestionItems>
                    <core:Item key="{state>text}" text="{state>text}" />
                  </suggestionItems>
                  <layoutData>
                    <FlexItemData growFactor="1" />
                  </layoutData>
                </Input>
                <Button
                  text="{i18n>view.add}"
                  icon="sap-icon://add"
                  type="Emphasized"
                  enabled="{= !${state>/subscriptionId} }"
                  press=".onAddTopic"
                  class="sapUiTinyMarginBegin" />
              </HBox>
              <List
                items="{path: 'state>/topics', templateShareable: false}"
                mode="{= ${state>/subscriptionId} ? 'None' : 'Delete' }"
                delete=".onDeleteTopic"
                showSeparators="Inner"
                noDataText="{i18n>view.noTopicsYetAddAtLeast}"
                class="aemTopicList sapUiTinyMarginTop">
                <StandardListItem title="{state>text}" icon="sap-icon://feeder-arrow" class="aemMono" />
              </List>
              <Text text="{i18n>view.wildcardsMatchesOneLevelMatchesEverything}" class="aemHint sapUiTinyMarginTop" />
            </VBox>
            <VBox visible="{= ${state>/sourceType} !== 'TOPIC' }">
              <layoutData>
                <l:GridData span="XL6 L8 M12 S12" />
              </layoutData>
              <Label text="{i18n>view.queueName}" labelFor="queue" required="true" />
              <Input
                id="queue"
                width="100%"
                value="{state>/queue}"
                placeholder="q.orders"
                enabled="{= !${state>/subscriptionId} }"
                submit=".onStart" />
            </VBox>
          </l:Grid>
          <MessageStrip
            text="{i18n>view.consumeRemovesTheMessagesFromThe}"
            type="Warning"
            showIcon="true"
            visible="{= ${state>/sourceType} === 'QUEUE_CONSUME' }"
            class="sapUiTinyMarginTop" />
        </VBox>
      </f:DynamicPageHeader>
    </f:header>
    <f:content>
      <l:Splitter height="100%" width="100%" class="aemSplit">
        <Table
          id="messages"
          class="aemCard"
          items="{path: 'state>/messages', templateShareable: false}"
          mode="SingleSelectMaster"
          selectionChange=".onSelect"
          sticky="ColumnHeaders,HeaderToolbar"
          growing="true"
          growingThreshold="100"
          growingScrollToLoad="true">
          <layoutData>
            <l:SplitterLayoutData size="58%" />
          </layoutData>
          <headerToolbar>
            <OverflowToolbar>
              <Title text="{i18n>view.messages}" />
              <ObjectNumber number="{state>/received}" emphasized="false" class="sapUiTinyMarginBegin" />
              <ToolbarSpacer />
              <SearchField width="16rem" placeholder="{i18n>view.filterTopicPayload}" liveChange=".onFilter" />
              <ToggleButton
                icon="{= ${state>/paused} ? 'sap-icon://media-play' : 'sap-icon://media-pause' }"
                text="{= ${state>/paused} ? ${i18n>view.resume} : ${i18n>view.pause} }"
                pressed="{state>/paused}"
                type="Transparent"
                tooltip="{i18n>view.pauseListUpdatesMessagesAreStill}" />
              <Button icon="sap-icon://clear-all" text="{i18n>view.clear}" type="Transparent" press=".onClear" />
            </OverflowToolbar>
          </headerToolbar>
          <noData>
            <IllustratedMessage
              illustrationSize="Spot"
              illustrationType="{= ${state>/subscriptionId} ? 'sapIllus-SimpleBell' : 'sapIllus-SimpleConnection' }"
              title="{= ${state>/subscriptionId} ? ${i18n>view.waiting} : ${i18n>view.notListening} }"
              description="{= ${state>/subscriptionId} ? ${i18n>view.waitingHint} : ${i18n>view.notListeningHint} }" />
          </noData>
          <columns>
            <Column width="7.5rem">
              <Text text="{i18n>view.time}" />
            </Column>
            <Column>
              <Text text="{i18n>view.topic}" />
            </Column>
            <Column width="8rem" minScreenWidth="Desktop" demandPopin="true">
              <Text text="{i18n>view.delivery}" />
            </Column>
            <Column width="5rem" hAlign="End" minScreenWidth="Desktop" demandPopin="true">
              <Text text="{i18n>view.size}" />
            </Column>
          </columns>
          <items>
            <!-- the selection is part of the message, so it stays on it when new rows are put on top -->
            <ColumnListItem type="Active" selected="{state>selected}">
              <cells>
                <Text text="{state>time}" wrapping="false" class="aemMono aemMuted" />
                <ObjectIdentifier title="{state>topic}" text="{state>correlationId}" class="aemMono" />
                <ObjectStatus
                  text="{state>deliveryMode}"
                  state="{= ${state>deliveryMode} === 'PERSISTENT' ? 'Information' : 'None' }" />
                <Text text="{state>size}" class="aemMuted" />
              </cells>
            </ColumnListItem>
          </items>
        </Table>
        <ScrollContainer height="100%" vertical="true" class="aemCard">
          <layoutData>
            <l:SplitterLayoutData size="auto" />
          </layoutData>
          <VBox class="aemDetail" visible="{= !!${state>/selected} }">
            <Title text="{state>/selected/topic}" wrapping="true" titleStyle="H4" class="aemMono" />
            <HBox wrap="Wrap" class="sapUiSmallMarginTop aemMeta">
              <ObjectStatus title="{i18n>view.received}" text="{state>/selected/receivedLocal}" class="sapUiMediumMarginEnd" />
              <ObjectStatus
                title="{i18n>view.delivery}"
                text="{state>/selected/deliveryMode}"
                state="{= ${state>/selected/deliveryMode} === 'PERSISTENT' ? 'Information' : 'None' }"
                class="sapUiMediumMarginEnd" />
              <ObjectStatus title="{i18n>view.size}" text="{state>/selected/size}" class="sapUiMediumMarginEnd" />
              <ObjectStatus
                title="{i18n>view.contentType}"
                text="{state>/selected/contentType}"
                visible="{= !!${state>/selected/contentType} }"
                class="sapUiMediumMarginEnd" />
              <ObjectStatus
                title="{i18n>view.correlationID}"
                text="{state>/selected/correlationId}"
                visible="{= !!${state>/selected/correlationId} }" />
            </HBox>
            <OverflowToolbar style="Clear" class="aemActions">
              <ToolbarSpacer />
              <Button text="{i18n>view.copyPayload}" icon="sap-icon://copy" type="Transparent" press=".onCopy" />
              <Button text="{i18n>view.save}" icon="sap-icon://save" type="Transparent" press=".onSave" enabled="{= !${state>/selected/savedId} }" />
              <Button text="{i18n>view.saveAsTestCase}" icon="sap-icon://add-document" type="Emphasized" press=".onSaveAsTestCase" />
            </OverflowToolbar>
            <IconTabBar expandable="false" applyContentPadding="false" headerMode="Inline" class="aemTabs">
              <items>
                <IconTabFilter key="payload" text="{i18n>view.payload}" icon="sap-icon://document-text">
                  <ce:CodeEditor type="{state>/selected/editorType}" value="{state>/selected/prettyPayload}" editable="false" height="26rem" />
                </IconTabFilter>
                <IconTabFilter key="properties" text="{i18n>view.userProperties}" icon="sap-icon://tag" count="{state>/selected/propertyCount}">
                  <ce:CodeEditor type="json" value="{state>/selected/prettyProperties}" editable="false" height="14rem" />
                </IconTabFilter>
              </items>
            </IconTabBar>
          </VBox>
          <IllustratedMessage
            illustrationType="sapIllus-NoEntries"
            title="{i18n>view.noMessageSelected}"
            description="{i18n>view.selectAMessageToSeeIts}"
            visible="{= !${state>/selected} }" />
        </ScrollContainer>
      </l:Splitter>
    </f:content>
  </f:DynamicPage>
</mvc:View>
