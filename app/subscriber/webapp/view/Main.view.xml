<mvc:View
  controllerName="com.aem.suite.subscriber.controller.Main"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:core="sap.ui.core"
  xmlns="sap.m"
  xmlns:f="sap.f"
  xmlns:l="sap.ui.layout"
  xmlns:ce="sap.ui.codeeditor"
  displayBlock="true"
  height="100%">
  <f:DynamicPage
    id="page"
    class="aemPage sapUiResponsiveContentPadding"
    toggleHeaderOnTitleClick="true"
    fitContent="true">
    <f:title>
      <f:DynamicPageTitle>
        <f:heading>
          <HBox alignItems="Center">
            <core:Icon src="sap-icon://feeder-arrow" size="1.5rem" color="Default" class="sapUiSmallMarginEnd aemTitleIcon" />
            <Title text="Live Subscriber" />
            <ObjectStatus
              text="{state>/status}"
              state="{= ${state>/subscriptionId} ? 'Success' : 'None' }"
              inverted="{= !!${state>/subscriptionId} }"
              icon="{= ${state>/subscriptionId} ? 'sap-icon://connected' : 'sap-icon://disconnected' }"
              class="sapUiMediumMarginBegin aemStatus" />
            <ObjectNumber
              number="{state>/received}"
              unit="messages"
              visible="{= !!${state>/subscriptionId} || ${state>/received} > 0 }"
              class="sapUiSmallMarginBegin aemStatus" />
            <ObjectStatus
              text="WebSocket offline"
              state="Warning"
              icon="sap-icon://alert"
              visible="{= !${state>/socketConnected} }"
              class="sapUiSmallMarginBegin aemStatus" />
          </HBox>
        </f:heading>
        <f:expandedContent>
          <Text text="Listen to topics or queues and watch the messages arrive in real time." />
        </f:expandedContent>
        <f:snappedContent>
          <HBox alignItems="Center" wrap="Wrap">
            <ObjectStatus text="{state>/brokerName}" icon="sap-icon://chain-link" class="sapUiSmallMarginEnd" />
            <Text text="{state>/sourceLabel}" class="aemMono" maxLines="1" />
          </HBox>
        </f:snappedContent>
        <f:actions>
          <Button
            text="Start"
            type="Emphasized"
            icon="sap-icon://media-play"
            enabled="{= !${state>/subscriptionId} &amp;&amp; !${state>/busy} }"
            press=".onStart" />
          <Button
            text="Stop"
            type="{= ${state>/subscriptionId} ? 'Reject' : 'Default' }"
            icon="sap-icon://stop"
            enabled="{= !!${state>/subscriptionId} &amp;&amp; !${state>/busy} }"
            press=".onStop" />
          <Button
            text="Active Subscriptions"
            type="Transparent"
            icon="sap-icon://list"
            press=".onShowActive" />
        </f:actions>
      </f:DynamicPageTitle>
    </f:title>
    <f:header>
      <f:DynamicPageHeader pinnable="false">
        <VBox class="aemConnect">
          <l:Grid defaultSpan="XL3 L4 M6 S12" hSpacing="1" vSpacing="0.5" containerQuery="true">
            <VBox>
              <Label text="Broker" labelFor="broker" required="true" />
              <Select
                id="broker"
                width="100%"
                forceSelection="false"
                selectedKey="{state>/brokerId}"
                enabled="{= !${state>/subscriptionId} }"
                change=".onBrokerChange"
                items="{path: '/Brokers', sorter: {path: 'name'}}">
                <core:Item key="{ID}" text="{name}" />
              </Select>
            </VBox>
            <VBox visible="{state>/needsUsername}">
              <Label text="Username" required="true" tooltip="Not maintained on the broker" />
              <Input
                width="100%"
                value="{state>/enteredUsername}"
                placeholder="Not maintained on the broker"
                enabled="{= !${state>/subscriptionId} }"
                submit=".onStart" />
            </VBox>
            <VBox visible="{state>/needsPassword}">
              <Label text="{= ${state>/username} ? 'Password for ' + ${state>/username} : 'Password' }" required="true" />
              <Input
                type="Password"
                width="100%"
                value="{state>/password}"
                placeholder="Not stored"
                enabled="{= !${state>/subscriptionId} }"
                submit=".onStart" />
            </VBox>
            <VBox>
              <Label text="Source" />
              <SegmentedButton
                width="100%"
                selectedKey="{state>/sourceType}"
                enabled="{= !${state>/subscriptionId} }">
                <items>
                  <SegmentedButtonItem key="TOPIC" text="Topics" icon="sap-icon://feeder-arrow" />
                  <SegmentedButtonItem key="QUEUE_BROWSE" text="Browse Queue" icon="sap-icon://show" />
                  <SegmentedButtonItem key="QUEUE_CONSUME" text="Consume Queue" icon="sap-icon://download" />
                </items>
              </SegmentedButton>
            </VBox>
            <VBox visible="{= ${state>/sourceType} === 'TOPIC' }">
              <layoutData>
                <l:GridData span="XL12 L12 M12 S12" />
              </layoutData>
              <Label text="Topic subscriptions" labelFor="topics" required="true" />
              <HBox>
                <Input
                  id="topics"
                  width="100%"
                  placeholder="Add a topic, e.g. acme/orders/&gt;"
                  enabled="{= !${state>/subscriptionId} }"
                  showSuggestion="true"
                  suggestionItems="{path: 'state>/topicHistory', templateShareable: false}"
                  suggestionItemSelected=".onAddTopic"
                  liveChange=".onTopicLiveChange"
                  submit=".onAddTopic">
                  <suggestionItems>
                    <core:Item key="{state>text}" text="{state>text}" />
                  </suggestionItems>
                  <layoutData>
                    <FlexItemData growFactor="1" />
                  </layoutData>
                </Input>
                <Button
                  text="Add"
                  icon="sap-icon://add"
                  type="Emphasized"
                  enabled="{= !${state>/subscriptionId} }"
                  press=".onAddTopic"
                  class="sapUiTinyMarginBegin" />
              </HBox>
              <List
                id="topicList"
                items="{path: 'state>/topics', templateShareable: false}"
                mode="{= ${state>/subscriptionId} ? 'None' : 'Delete' }"
                delete=".onDeleteTopic"
                showSeparators="Inner"
                noDataText="No topics yet - add at least one"
                class="aemTopicList sapUiTinyMarginTop">
                <StandardListItem title="{state>text}" icon="sap-icon://feeder-arrow" class="aemMono" />
              </List>
              <Text text="Wildcards: * matches one level, &gt; matches everything below. Several topics: add them one by one, or separate them with commas." class="aemHint sapUiTinyMarginTop" />
            </VBox>
            <VBox visible="{= ${state>/sourceType} !== 'TOPIC' }">
              <layoutData>
                <l:GridData span="XL6 L8 M12 S12" />
              </layoutData>
              <Label text="Queue name" labelFor="queue" required="true" />
              <Input
                id="queue"
                width="100%"
                value="{state>/queue}"
                placeholder="q.orders"
                enabled="{= !${state>/subscriptionId} }"
                submit=".onStart" />
            </VBox>
          </l:Grid>
          <MessageStrip
            text="Consume removes the messages from the queue (client acknowledgement). Browse leaves them on the queue."
            type="Warning"
            showIcon="true"
            visible="{= ${state>/sourceType} === 'QUEUE_CONSUME' }"
            class="sapUiTinyMarginTop" />
        </VBox>
      </f:DynamicPageHeader>
    </f:header>
    <f:content>
      <l:Splitter height="100%" width="100%" class="aemSplit">
        <Table
          id="messages"
          class="aemCard"
          items="{path: 'state>/messages', templateShareable: false}"
          mode="SingleSelectMaster"
          selectionChange=".onSelect"
          sticky="ColumnHeaders,HeaderToolbar"
          growing="true"
          growingThreshold="100"
          growingScrollToLoad="true">
          <layoutData>
            <l:SplitterLayoutData size="58%" />
          </layoutData>
          <headerToolbar>
            <OverflowToolbar>
              <Title text="Messages" />
              <ObjectNumber number="{state>/received}" emphasized="false" class="sapUiTinyMarginBegin" />
              <ToolbarSpacer />
              <SearchField width="16rem" placeholder="Filter topic / payload" liveChange=".onFilter" />
              <ToggleButton
                icon="{= ${state>/paused} ? 'sap-icon://media-play' : 'sap-icon://media-pause' }"
                text="{= ${state>/paused} ? 'Resume' : 'Pause' }"
                pressed="{state>/paused}"
                type="Transparent"
                tooltip="Pause list updates (messages are still counted)" />
              <Button icon="sap-icon://clear-all" text="Clear" type="Transparent" press=".onClear" />
            </OverflowToolbar>
          </headerToolbar>
          <noData>
            <IllustratedMessage
              illustrationSize="Spot"
              illustrationType="{= ${state>/subscriptionId} ? 'sapIllus-SimpleBell' : 'sapIllus-SimpleConnection' }"
              title="{= ${state>/subscriptionId} ? 'Waiting for messages…' : 'Not listening yet' }"
              description="{= ${state>/subscriptionId} ? 'New messages appear here as soon as they arrive.' : 'Choose a broker and a topic or queue, then press Start.' }" />
          </noData>
          <columns>
            <Column width="7.5rem">
              <Text text="Time" />
            </Column>
            <Column>
              <Text text="Topic" />
            </Column>
            <Column width="8rem" minScreenWidth="Desktop" demandPopin="true">
              <Text text="Delivery" />
            </Column>
            <Column width="5rem" hAlign="End" minScreenWidth="Desktop" demandPopin="true">
              <Text text="Size" />
            </Column>
          </columns>
          <items>
            <ColumnListItem type="Active">
              <cells>
                <Text text="{state>time}" wrapping="false" class="aemMono aemMuted" />
                <ObjectIdentifier title="{state>topic}" text="{state>correlationId}" class="aemMono" />
                <ObjectStatus
                  text="{state>deliveryMode}"
                  state="{= ${state>deliveryMode} === 'PERSISTENT' ? 'Information' : 'None' }" />
                <Text text="{state>size}" class="aemMuted" />
              </cells>
            </ColumnListItem>
          </items>
        </Table>
        <ScrollContainer height="100%" vertical="true" class="aemCard">
          <layoutData>
            <l:SplitterLayoutData size="auto" />
          </layoutData>
          <VBox class="aemDetail" visible="{= !!${state>/selected} }">
            <Title text="{state>/selected/topic}" wrapping="true" titleStyle="H4" class="aemMono" />
            <HBox wrap="Wrap" class="sapUiSmallMarginTop aemMeta">
              <ObjectStatus title="Received" text="{state>/selected/receivedLocal}" class="sapUiMediumMarginEnd" />
              <ObjectStatus
                title="Delivery"
                text="{state>/selected/deliveryMode}"
                state="{= ${state>/selected/deliveryMode} === 'PERSISTENT' ? 'Information' : 'None' }"
                class="sapUiMediumMarginEnd" />
              <ObjectStatus title="Size" text="{state>/selected/size}" class="sapUiMediumMarginEnd" />
              <ObjectStatus
                title="Content type"
                text="{state>/selected/contentType}"
                visible="{= !!${state>/selected/contentType} }"
                class="sapUiMediumMarginEnd" />
              <ObjectStatus
                title="Correlation ID"
                text="{state>/selected/correlationId}"
                visible="{= !!${state>/selected/correlationId} }" />
            </HBox>
            <OverflowToolbar style="Clear" class="aemActions">
              <ToolbarSpacer />
              <Button text="Copy Payload" icon="sap-icon://copy" type="Transparent" press=".onCopy" />
              <Button text="Save" icon="sap-icon://save" type="Transparent" press=".onSave" enabled="{= !${state>/selected/savedId} }" />
              <Button text="Save as Test Case" icon="sap-icon://add-document" type="Emphasized" press=".onSaveAsTestCase" />
            </OverflowToolbar>
            <IconTabBar expandable="false" applyContentPadding="false" headerMode="Inline" class="aemTabs">
              <items>
                <IconTabFilter key="payload" text="Payload" icon="sap-icon://document-text">
                  <ce:CodeEditor type="{state>/selected/editorType}" value="{state>/selected/prettyPayload}" editable="false" height="26rem" />
                </IconTabFilter>
                <IconTabFilter key="properties" text="User Properties" icon="sap-icon://tag" count="{state>/selected/propertyCount}">
                  <ce:CodeEditor type="json" value="{state>/selected/prettyProperties}" editable="false" height="14rem" />
                </IconTabFilter>
              </items>
            </IconTabBar>
          </VBox>
          <IllustratedMessage
            illustrationType="sapIllus-NoEntries"
            title="No message selected"
            description="Select a message to see its payload and properties"
            visible="{= !${state>/selected} }" />
        </ScrollContainer>
      </l:Splitter>
    </f:content>
  </f:DynamicPage>
</mvc:View>
