{
  "compilerOptions": {
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "node",
    "skipLibCheck": true,
    "allowJs": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "noEmit": true,
    "lib": ["es2022", "dom"],
    "rootDir": "./webapp",
    "baseUrl": "./",
    "types": ["@sapui5/types"],
    "paths": {
      "aem/suite/subscriber/*": ["./webapp/*"]
    }
  },
  "include": ["./webapp/**/*"]
}
